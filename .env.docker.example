############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
REALTIME_SECRET_KEY_BASE=your-super-secret-realtime-key-with-at-least-32-characters-long

# Generate ANON_KEY and SERVICE_ROLE_KEY using JWT generator
# https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

############
# Database
############

# Can be used to connect to your database from your local machine
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:5432/postgres

############
# API Proxy
############

# Kong API Gateway URL
API_EXTERNAL_URL=http://localhost:8000

# Site URL for redirects
SITE_URL=http://localhost

# Additional redirect URLs (comma separated)
ADDITIONAL_REDIRECT_URLS=

############
# Auth
############

# Disable email signups (set to true for production if you manage users manually)
DISABLE_SIGNUP=false

# Enable email confirmation (set to false to auto-confirm)
ENABLE_EMAIL_AUTOCONFIRM=true

# Enable email signup
ENABLE_EMAIL_SIGNUP=true

# JWT expiry in seconds (3600 = 1 hour)
JWT_EXPIRY=3600

############
# Email (Optional - for password resets, etc.)
############

SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Kiosk Management System

############
# Dashboard
############

# Studio credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-dashboard-password
